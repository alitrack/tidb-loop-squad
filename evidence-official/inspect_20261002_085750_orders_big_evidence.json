      "sql": "SELECT LEFT(digest_text,80) sql_text, exec_count,\n        SUM_ERRORS errors, SUM_WARNINGS warnings,\n        ROUND(avg_latency/1e6,1) avg_ms, ROUND(max_latency/1e6,1) max_ms,\n        ROUND(sum_latency/1e6,1) total_ms, AVG_RESULT_ROWS avg_rows\n        FROM information_schema.statements_summary_history\n        ORDER BY sum_latency DESC LIMIT 10",
      "source": "INFORMATION_SCHEMA.STATEMENTS_SUMMARY_HISTORY"
    },
    {
      "name": "biz_sql",
      "sql": "SELECT LEFT(digest_text,80) sql_text, schema_name,\n        exec_count, SUM_ERRORS errors, ROUND(avg_latency/1e6,1) avg_ms,\n        ROUND(max_latency/1e6,1) max_ms, ROUND(sum_latency/1e6,1) total_ms\n        FROM information_schema.statements_summary_history\n        WHERE digest_text NOT LIKE '%information_schema%'\n        ORDER BY sum_latency DESC LIMIT 10",
      "source": "INFORMATION_SCHEMA.STATEMENTS_SUMMARY_HISTORY"
    },
    {
      "name": "error_sql",
      "sql": "SELECT LEFT(digest_text,80) sql_text, schema_name,\n        exec_count, SUM_ERRORS errors, SUM_WARNINGS warnings\n        FROM information_schema.statements_summary_history\n        WHERE SUM_ERRORS > 0 ORDER BY SUM_ERRORS DESC LIMIT 10",
      "source": "INFORMATION_SCHEMA.STATEMENTS_SUMMARY_HISTORY"
    },
    {
      "name": "error_summary",
      "sql": "SELECT SUM(EXEC_COUNT) exec_count,\n        SUM(SUM_ERRORS) errors, SUM(SUM_WARNINGS) warnings,\n        MIN(SUMMARY_BEGIN_TIME) window_begin, MAX(SUMMARY_END_TIME) window_end\n        FROM information_schema.statements_summary_history",
      "source": "INFORMATION_SCHEMA.STATEMENTS_SUMMARY_HISTORY"
    },
    {
      "name": "lock_waits",
